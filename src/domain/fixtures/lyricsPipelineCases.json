  {
    "name": "empty_original_removes_linked_translation",
    "operation": "text",
    "raw": "<?xml version=\"1.0\"?><tt xmlns=\"http://www.w3.org/ns/ttml\" xmlns:itunes=\"http://music.apple.com/lyric-ttml-internal\"><head><metadata><iTunesMetadata xmlns=\"http://music.apple.com/lyric-ttml-internal\"><translations><translation xml:lang=\"en\"><text for=\"L1\">Removed</text><text for=\"L2\">Kept</text></translation></translations></iTunesMetadata></metadata></head><body><div><p begin=\"1s\" end=\"2s\" itunes:key=\"L1\">---</p><p begin=\"2s\" end=\"3s\" itunes:key=\"L2\">保留</p></div></body></tt>",
    "options": { "targetFormat": "plainLrc", "removeEmptyLines": true },
    "expect": {
      "text": "[00:02.000]保留\n[00:02.000]Kept",
      "notContains": ["Removed", "---"],
      "warnings": [],
      "sourceFormat": "ttml",
      "targetFormat": "plainLrc"
    }
  },
  {
    "name": "tag_filter_removes_linked_tracks_and_reports_unknown_namespace",
    "operation": "plugin",
    "result": {
      "rawTtml": "<?xml version=\"1.0\"?><tt xmlns=\"http://www.w3.org/ns/ttml\" xmlns:itunes=\"http://music.apple.com/lyric-ttml-internal\" xmlns:foo=\"urn:provider\"><head><metadata><iTunesMetadata xmlns=\"http://music.apple.com/lyric-ttml-internal\"><translations><translation><text for=\"L1\">translation credit</text><text for=\"L2\">译文</text></translation></translations></iTunesMetadata></metadata></head><body><div><p begin=\"1s\" end=\"2s\" itunes:key=\"L1\">producer credit</p><p begin=\"2s\" end=\"3s\" itunes:key=\"L2\">歌词</p></div></body></tt>"
    },
    "targetFormat": "plainLrc",
    "options": { "removeTagLineKeywords": ["credit"] },
    "expect": {
      "text": "[00:02.000]歌词\n[00:02.000]译文",
      "notContains": ["credit"],
      "warnings": ["TTML extension cannot be represented in plainLrc: urn:provider"],
      "sourceFormat": "ttml",
      "targetFormat": "plainLrc"
    }
  },
  {
    "name": "ttml_keeps_agents_keys_tracks_and_text_node_spaces",
    "operation": "plugin",
    "result": {
      "rawTtml": "<?xml version=\"1.0\"?><tt xmlns=\"http://www.w3.org/ns/ttml\" xmlns:ttm=\"http://www.w3.org/ns/ttml#metadata\" xmlns:itunes=\"http://music.apple.com/lyric-ttml-internal\" xml:lang=\"zh-Hans\"><head><metadata><ttm:agent xml:id=\"v1\" type=\"person\">歌手</ttm:agent></metadata><metadata><iTunesMetadata xmlns=\"http://music.apple.com/lyric-ttml-internal\"><translations><translation xml:lang=\"en\"><text for=\"line-1\">Story</text></translation></translations></iTunesMetadata></metadata></head><body><div><p begin=\"1.5s\" end=\"3s\" itunes:key=\"line-1\" ttm:agent=\"v1\"><span begin=\"1.5s\" end=\"2s\">hello</span> <span begin=\"2s\" end=\"3s\">world</span><span ttm:role=\"x-romanization\">gushi</span><span ttm:role=\"x-bg\">和声</span></p></div></body></tt>"
    },
    "targetFormat": "ttml",
    "options": { "showTranslation": true, "showRomanization": false, "forceRewrite": true },
    "expect": {
      "contains": ["xml:lang=\"zh-Hans\"", "xml:id=\"v1\"", "ttm:agent=\"v1\"", "itunes:key=\"line-1\"", "for=\"line-1\">Story</text>", "ttm:role=\"x-bg\"", ">hello</span> <span begin=\""],
      "notContains": ["gushi"],
      "warnings": [],
      "sourceFormat": "ttml",
      "targetFormat": "ttml"
    }
  },
