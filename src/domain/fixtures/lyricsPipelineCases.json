[
  {
    "name": "structured_tracks_follow_requested_line_order",
    "operation": "plugin",
    "result": {
      "type": "structured",
      "tags": { "ti": "晴天", "ar": "周杰伦" },
      "original": [[1000, 2000, [[1000, 1500, "故"], [1500, 2000, "事"]]]],
      "translated": [[1000, 2000, "Story"]],
      "romanization": [[1000, 2000, "gushi"]]
    },
    "targetFormat": "plainLrc",
    "options": {
      "lineOrder": ["translation", "original", "romanization"],
      "offsetMs": 500
    },
    "expect": {
      "contains": ["[ti:晴天]", "[ar:周杰伦]"],
      "sameTimestampLines": {
        "timestamp": "[00:01.500]",
        "lines": ["[00:01.500]Story", "[00:01.500]故事", "[00:01.500]gushi"]
      },
      "warnings": [],
      "sourceFormat": null,
      "targetFormat": "plainLrc"
    }
  },
  {
    "name": "structured_result_writes_enhanced_lrc",
    "operation": "plugin",
    "result": {
